# group-chat — GroupAdmin / GroupChat / ban+scope sources / 4 managers.
#
# Both plugin slots are REQUIRED keys in the sibling deploy script: the zero address means "not
# mounted", and a missing key must not be conflated with "chose not to mount" (that is why the
# values are spelled out as the zero address instead of being omitted).
#
# GROUP_CHAT_MAX_ADMIN_IDS >= 1, GROUP_CHAT_ACTION_RECENT_ROUNDS >= 1,
# MIN_SUPPORT_TO_OPPOSE_MULTIPLIER >= 1, BAN_THRESHOLD_RATIO <= 1e18.
# The group name generated by the managers is `<typeCode><sep><randomHex>` plus the "Test" prefix,
# so MemberNFT.MAX_NAME_LENGTH must be >= 11; core.params sets 32.
GROUP_CHAT_ACTION_RECENT_ROUNDS=3
GROUP_CHAT_MAX_ADMIN_IDS=20
GROUP_CHAT_MIN_SUPPORT_TO_OPPOSE_MULTIPLIER=10
GROUP_CHAT_BAN_THRESHOLD_RATIO=3e15
GROUP_CHAT_BEFORE_POST_PLUGIN_ADDRESS=0x0000000000000000000000000000000000000000
GROUP_CHAT_AFTER_POST_PLUGIN_ADDRESS=0x0000000000000000000000000000000000000000

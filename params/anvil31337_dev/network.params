# Local chain process + connection parameters for the anvil31337_dev profile.
#
# These are OUR values (this repo is the source of truth for the local chain), not a copy of any
# sibling repo's network.params. The sibling files only pin CHAIN_ID / RPC_URL / ETHERSCAN_API_KEY;
# the process flags below are what `make anvil` needs and they are the reason this file exists.
#
# The chain is started by `anvil` with exactly these flags:
#   --chain-id $CHAIN_ID --host $ANVIL_HOST --port $ANVIL_PORT
#   --accounts $ANVIL_ACCOUNTS --balance $ANVIL_BALANCE --gas-limit $ANVIL_GAS_LIMIT
#   --code-size-limit $ANVIL_CODE_SIZE_LIMIT --base-fee $ANVIL_BASE_FEE
#
# No --block-time is passed at startup: anvil runs in automine mode (one transaction == one block)
# for the whole bootstrap, which makes the exported block numbers deterministic as well as the
# addresses. After `make verify` the orchestrator enables interval mining with the value below
# (`anvil_setIntervalMining`). `make anvil` (standalone) enables it immediately after startup.
#
# RPC_URL is DERIVED from ANVIL_HOST/ANVIL_PORT by script/lib/params.sh (http://<host>:<port>) and
# is exported for every forge/cast call. It is deliberately not a file key: overriding the port with
# `make bootstrap PORT=8555` must move the RPC endpoint with it, and a second key could disagree.
#
# ANVIL_BLOCK_TIME is the post-bootstrap interval: one block per second even when idle, so a
# 120-block phase is ~2 minutes of wall clock (120 blocks x 1 s), matching PHASE_TARGET_SECONDS=120.
# PHASE_ORIGIN_BLOCKS / PHASE_ORIGIN_PHASE_BLOCKS in core.params are chosen against this.
CHAIN_ID=31337
ANVIL_HOST=127.0.0.1
ANVIL_PORT=8545
# 8545 is the developer's canonical "human" chain: a browser wallet is connected to it, so
# automated runs must never bootstrap, snapshot or revert it. Ports are parameterised so a second
# chain can coexist: `make bootstrap PORT=8555` (the frontend e2e suite does this) moves ANVIL_PORT
# and every derived RPC URL together, and keeps its pid file + logs in `.anvil/8555/` instead of
# the flat `.anvil/` used by the default 8545 chain.
ANVIL_BLOCK_TIME=1
ANVIL_ACCOUNTS=20
ANVIL_BALANCE=10000
ANVIL_GAS_LIMIT=60000000
ANVIL_CODE_SIZE_LIMIT=100000
ANVIL_BASE_FEE=1000000000

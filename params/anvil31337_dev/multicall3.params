# Multicall3 — deployed at its canonical cross-chain address.
#
# Multicall3 is the same contract at 0xcA11bde05977b3631167028862bE2a173976CA11 on 250+ chains, so
# the frontend can batch calls locally with the exact code path it will use in production.
#
# It is deployed by REPLAYING the deployer's pre-signed raw transaction published in the upstream
# repo (mds1/multicall README, "Deploy it yourself using a pre-signed transaction"): a legacy,
# chain-agnostic transaction from 0x05f32b3cc3888453ff71b01135b34ff8e41263f2 with nonce 0, gas
# limit 1,000,000 and gas price 100 gwei. CREATE(0x05f3..., 0) is what puts the code at the canonical
# address - no CREATE2, no hand-written bytecode. `cast compute-address 0x05f32b... --nonce 0` ==
# 0xcA11bde05977b3631167028862bE2a173976CA11 is asserted in script/local.sh before publishing.
#
# Funding: the deployer EOA starts with a zero balance on a fresh chain, so it is credited exactly
# MULTICALL3_DEPLOYER_FUNDING wei via the anvil-only `anvil_setBalance` RPC. The transaction's
# gas cost is 1,000,000 * 100 gwei = 0.0001 ETH; 0.1 ETH is funded so a future gas-price change
# cannot strand the transaction, and the exact cost is documented here deliberately.
#
# The raw transaction lives in a fixture file (like the airdrop snapshot) because it is data, not a
# tunable: MULTICALL3_SIGNED_TX_FILE must contain the hex without the 0x prefix or newlines.
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
MULTICALL3_DEPLOYER_ADDRESS=0x05f32b3cc3888453ff71b01135b34ff8e41263f2
MULTICALL3_DEPLOYER_NONCE=0
MULTICALL3_DEPLOYER_FUNDING=100000000000000000
MULTICALL3_SIGNED_TX_FILE=fixtures/multicall3/multicall3_signed_tx.hex
# sha256 of the file with all newlines stripped (18,000+ hex chars over one line, 3,926 bytes).
MULTICALL3_SIGNED_TX_SHA256=989226d0c5b9621695bdee807cf94cd0c65031857ed6911882ab6fd81e7e6813
